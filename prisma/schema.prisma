generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AccountAccessTokenType {
  DOCTOR_INVITE
  PASSWORD_RESET
}

enum ConsultationStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConsultationDiagnosisStatus {
  NOT_IDENTIFIED
  PRELIMINARY
  REQUIRES_FURTHER_EXAMINATION
  CONFIRMED
  CANNOT_DETERMINE_ONLINE
  REFERRED_TO_SPECIALIST
  NOT_APPLICABLE
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
  CALL_STARTED
  CALL_ENDED
}

enum ConsultationCallSessionStatus {
  CREATED
  ACTIVE
  ENDED
}

enum ScheduleSlotStatus {
  AVAILABLE
  BOOKED
  CANCELLED
  BLOCKED
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  LOGIN_FAILED
  DOCTOR_CREATED
  DOCTOR_UPDATED
  DOCTOR_INVITE_CREATED
  ACCOUNT_PASSWORD_SET
  PASSWORD_RESET_CREATED
  PASSWORD_RESET_COMPLETED
  SPECIALTY_CREATED
  SPECIALTY_UPDATED
  CONSULTATION_CREATED
  CONSULTATION_STATUS_CHANGED
  FILE_UPLOADED
  PRIVATE_DATA_ACCESSED
  VIDEO_CALL_SESSION_CREATED
  VIDEO_CALL_JOIN_TOKEN_CREATED
  TWO_FACTOR_SETUP_COMPLETED
  TWO_FACTOR_CHALLENGE_COMPLETED
  TWO_FACTOR_RECOVERY_CODE_USED
}

model User {
  id                            String                    @id @default(cuid())
  email                         String                    @unique
  passwordHash                  String
  passwordChangedAt             DateTime?
  termsAcceptedAt               DateTime?
  privacyAcceptedAt             DateTime?
  telemedicineConsentAcceptedAt DateTime?
  legalConsentVersion           String?
  role                          UserRole                  @default(PATIENT)
  name                          String?
  phone                         String?
  avatarStoragePath             String?
  isActive                      Boolean                   @default(true)
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  sessions                      Session[]
  patientProfile                PatientProfile?
  doctorProfile                 DoctorProfile?
  messages                      Message[]                 @relation("MessageSender")
  attachments                   Attachment[]              @relation("AttachmentUploader")
  auditLogs                     AuditLog[]                @relation("AuditActor")
  createdCallSessions           ConsultationCallSession[] @relation("CallSessionCreator")
  accountAccessTokens           AccountAccessToken[]      @relation("AccessTokenUser")
  createdAccessTokens           AccountAccessToken[]      @relation("AccessTokenCreator")
  twoFactorSecret               TwoFactorSecret?
  twoFactorRecoveryCodes        TwoFactorRecoveryCode[]
  twoFactorChallenges           TwoFactorChallenge[]

  @@index([role])
  @@index([isActive])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountAccessToken {
  id          String                 @id @default(cuid())
  userId      String
  type        AccountAccessTokenType
  tokenHash   String                 @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime               @default(now())
  user        User                   @relation("AccessTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?                  @relation("AccessTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdById])
}

model PatientProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  dateOfBirth   DateTime?
  gender        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations Consultation[] @relation("PatientConsultations")
  doctorReviews DoctorReview[]
}

model DoctorProfile {
  id               String               @id @default(cuid())
  userId           String               @unique
  specialtyId      String?
  title            String?
  bio              String?
  education        String?
  experienceYears  Int?
  avatarUrl        String?
  photoStoragePath String?
  isAvailable      Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty        Specialty?           @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  scheduleSlots    DoctorScheduleSlot[]
  consultations    Consultation[]       @relation("DoctorConsultations")
  doctorReviews    DoctorReview[]

  @@index([specialtyId])
  @@index([isAvailable])
}

model Specialty {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  doctors     DoctorProfile[]

  @@index([isActive])
}

model DoctorScheduleSlot {
  id           String             @id @default(cuid())
  doctorId     String
  startsAt     DateTime
  endsAt       DateTime
  status       ScheduleSlotStatus @default(AVAILABLE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  doctor       DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultation Consultation?

  @@unique([doctorId, startsAt, endsAt])
  @@index([doctorId])
  @@index([startsAt])
  @@index([status])
}

model Consultation {
  id                   String                       @id @default(cuid())
  patientId            String
  doctorId             String
  scheduleSlotId       String?                      @unique
  scheduledAt          DateTime
  status               ConsultationStatus           @default(REQUESTED)
  subject              String?
  description          String?
  doctorNotes          String?
  diagnosisStatus      ConsultationDiagnosisStatus?
  diagnosisDetails     String?
  recommendations      String?
  medicationNotes      String?
  followUpInstructions String?
  additionalNotes      String?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  patient              PatientProfile               @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Restrict)
  doctor               DoctorProfile                @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: Restrict)
  scheduleSlot         DoctorScheduleSlot?          @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  messages             Message[]
  attachments          Attachment[]
  doctorReview         DoctorReview?
  callSessions         ConsultationCallSession[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([scheduledAt])
}

model ConsultationCallSession {
  id               String                        @id @default(cuid())
  consultationId   String
  provider         String
  providerRoomName String
  providerRoomUrl  String?
  status           ConsultationCallSessionStatus @default(CREATED)
  createdByUserId  String?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  consultation     Consultation                  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  createdBy        User?                         @relation("CallSessionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([consultationId, providerRoomName])
  @@index([consultationId])
  @@index([status])
  @@index([createdByUserId])
}

model DoctorReview {
  id               String         @id @default(cuid())
  rating           Int
  comment          String?
  consultationId   String         @unique
  doctorProfileId  String
  patientProfileId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  consultation     Consultation   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  doctorProfile    DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId])
  @@index([patientProfileId])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(cuid())
  consultationId String
  senderId       String
  type           MessageType  @default(TEXT)
  body           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  attachments    Attachment[]

  @@index([consultationId])
  @@index([senderId])
  @@index([createdAt])
}

model Attachment {
  id             String       @id @default(cuid())
  consultationId String
  messageId      String?
  uploadedById   String
  fileName       String
  fileType       String
  fileSize       Int
  storagePath    String
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy     User         @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([consultationId])
  @@index([messageId])
  @@index([uploadedById])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model TwoFactorSecret {
  id              String    @id @default(cuid())
  userId          String    @unique
  encryptedSecret String
  enabledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, usedAt])
}

model TwoFactorChallenge {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  attempts    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
