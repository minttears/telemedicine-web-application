# Database
# Supabase pooled connection URL for application queries through Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"

# Supabase direct connection URL for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase server-only key. Never expose this to client code.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Application
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
APP_URL="http://localhost:3000"

# Optional, useful after deployment
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email
# Real provider keys must be set only in .env.local and deployment variables.
EMAIL_PROVIDER="resend"
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="Telemedicine <no-reply@example.com>"
EMAIL_REPLY_TO=""

# Video calls
# Daily API key is server-only. Never expose it with a NEXT_PUBLIC_ name.
VIDEO_PROVIDER="daily"
DAILY_API_KEY="replace-with-daily-api-key"
DAILY_API_BASE_URL="https://api.daily.co/v1"
DAILY_ROOM_DOMAIN="your-daily-domain.daily.co"

# Optional future features
# OPENAI_API_KEY=""
